projection;
strict ( 2 );

define behavior for ZC_DD_Object alias TechObject
use etag
{
  use create;
  use update;
  use delete;

  use association _Dependency { create; }
}

define behavior for ZC_DD_ObjectDep alias ObjectDependency
use etag
{
  use update;
  use delete;

  use association _Object;
}

projection;
strict ( 2 );

define behavior for ZC_DD_Transport alias Transport
use etag
{
  use create;
  use update;
  use delete;

  use action markReleased;
  use action recordImport;

  use association _Dependency { create; }
}

define behavior for ZC_DD_TransportDep alias TransportDependency
use etag
{
  use update;
  use delete;

  use association _Transport;
}

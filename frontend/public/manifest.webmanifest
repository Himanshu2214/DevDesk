{
  "name": "SLATE·SPACE",
  "short_name": "SLATE·SPACE",
  "description": "Tickets, time, transports and knowledge for SAP developers – in one calm workspace.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#13161b",
  "theme_color": "#13161b",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "My tickets", "url": "./#list/active", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Timesheet", "url": "./#timesheet", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "./#insights", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

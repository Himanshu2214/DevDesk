{
  "name": "slate-space-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sap": "vite --mode sap",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:cloud": "vite --mode supabase",
    "build:cloud": "tsc -b && vite build --mode supabase",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "playwright test --project=sample --project=mobile",
    "e2e:cloud": "playwright test --project=cloud",
    "e2e:report": "playwright show-report e2e-report",
    "build:app": "tsc -b && vite build --mode supabase --outDir dist-app --emptyOutDir && cap sync android"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@dnd-kit/core": "6.1.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@supabase/supabase-js": "2.117.3",
    "@svar-ui/react-gantt": "2.8.1",
    "@tanstack/react-query": "5.59.20",
    "@tiptap/extension-link": "2.9.1",
    "@tiptap/extension-placeholder": "2.9.1",
    "@tiptap/extension-task-item": "2.9.1",
    "@tiptap/extension-task-list": "2.9.1",
    "@tiptap/pm": "2.9.1",
    "@tiptap/react": "2.9.1",
    "@tiptap/starter-kit": "2.9.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "dompurify": "3.4.17",
    "echarts": "5.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "0.460.0",
    "mermaid": "12.2.0",
    "motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
